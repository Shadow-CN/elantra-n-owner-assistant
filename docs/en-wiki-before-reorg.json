        "id": "05",
        "title": "紧固扭矩",
        "subtitle": "TORQUE SPECIFICATIONS",
        "cards": [
          {
            "title": "建议值",
            "lines": [
              "放油螺丝：34.3–44.1 N·m，建议 40 N·m",
              "机油滤清器：11.8–15.7 N·m，建议 14 N·m",
              "轮毂螺母：107.9–127.5 N·m，建议 120 N·m"
            ]
          }
        ]
      },
      {
        "id": "06",
        "title": "轮胎性能指南",
        "subtitle": "PS4S HN · TIRE PRESSURE",
        "cards": [
          {
            "title": "胎压与调整",
            "lines": [
              "热胎最佳：35–37 PSI / 241–255 kPa / 2.41–2.55 bar",
              "冷胎起始：32–33 PSI / 220.6–227.5 kPa / 2.21–2.28 bar",
              "同胎设定：前后同压起步",
              "转向不足：后轮 +2 PSI；转向过度：前轮 +2 PSI"
            ]
          }
        ]
      },
