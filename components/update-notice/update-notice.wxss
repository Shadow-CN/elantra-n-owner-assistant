/* ── 版本更新弹窗 ── */
.update-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(0, 0, 0, 0.45);
}

.update-card {
  width: 100%;
  padding: 36rpx 32rpx 28rpx;
  border: 1rpx solid var(--border-default);
  border-radius: 24rpx;
  background: var(--bg-card);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.update-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.update-version {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.update-date {
  color: var(--text-hint);
  font-size: 22rpx;
}

.update-title {
  margin-top: 18rpx;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.update-list {
  max-height: 520rpx;
  margin-top: 20rpx;
  overflow-y: auto;
}

.update-entry + .update-entry {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-item);
}

.update-entry-version {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.update-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 12rpx;
}

.update-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}

.update-text {
  flex: 1;
  min-width: 0;
  color: var(--text-chip);
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-word;
}

.update-btn {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: var(--bg-accent);
  color: var(--text-accent);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.update-btn-active {
  opacity: 0.8;
}

