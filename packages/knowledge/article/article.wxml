<page-meta page-style="{{pageStyle}}" />
<navigation-bar title="Wiki 词条" back="{{canGoBack}}" color="{{navColor}}" background="{{navBg}}"><view wx:if="{{!canGoBack}}" slot="left" class="home-link" bindtap="onWikiHome">目录</view><view slot="right" class="theme-toggle" bindtap="onThemeToggle" aria-role="button" aria-label="切换主题"><view class="theme-icon theme-icon-{{themeMode}}"></view></view></navigation-bar>
<scroll-view scroll-y class="article-scroll" scroll-into-view="{{scrollTarget}}" scroll-with-animation><view class="article-body">
  <block wx:if="{{article}}">
    <view class="breadcrumb"><text bindtap="onWikiHome">{{modelName}} Wiki</text><text class="separator"> / </text><text bindtap="onCategory">{{article.sectionTitle}}</text></view>
    <view id="article-top" class="article-title">{{article.title}}</view><text class="article-category">{{article.sectionTitle}} · 车主资料</text>
    <view wx:if="{{mediaLoading}}" class="caption">正在加载云端图片…</view><view wx:if="{{mediaError}}" class="media-error"><text>{{mediaError}}</text><button size="mini" bindtap="loadMedia">重试加载图片</button></view><view class="article-tools"><text bindtap="onCopyArticle">复制词条</text><text bindtap="onCategory">浏览分类 ›</text></view>
    <view class="contents"><text class="contents-title">本页目录</text><text bindtap="onAnchor" data-target="article-content">01 内容与参数</text><text wx:if="{{images.length}}" bindtap="onAnchor" data-target="{{firstImageAnchor}}">02 参考图片（{{images.length}}）</text><text wx:if="{{article.document}}" bindtap="onAnchor" data-target="article-document">查看原文件</text><text wx:if="{{article.resource}}" bindtap="onAnchor" data-target="article-resource">配置文件</text><text wx:if="{{related.length}}" bindtap="onAnchor" data-target="article-related">{{model==='elantra'?'关联词条':'同分类词条'}}</text><text bindtap="onAnchor" data-target="article-source">来源与说明</text></view>
    <view id="article-content" class="article-section"><view class="section-title">{{model==='5n'?'正文':'内容与参数'}}</view><text class="caption">点击文字或编号可复制</text>
      <view wx:if="{{article.parts}}" class="parts-list"><view wx:for="{{article.parts}}" wx:for-item="part" wx:key="index" class="part-row"><view class="part-heading"><text class="part-name">{{part.name}}</text><text wx:if="{{part.brand}}" class="part-brand">{{part.brand}}</text></view><view class="part-codes"><button wx:for="{{part.codes}}" wx:for-item="code" wx:key="*this" class="part-code" size="mini" bindtap="onCopyLine" data-value="{{code}}"><text>{{code}}</text><text class="copy-label">复制</text></button></view><text wx:if="{{part.note}}" class="caption">{{part.note}}</text></view></view>
      <block wx:if="{{article.blocks}}"><view wx:for="{{article.blocks}}" wx:for-item="block" wx:key="index" id="article-block-{{index}}" class="source-block">
        <text wx:if="{{block.type==='text'}}" class="paragraph source-indent-{{block.indent}}" bindtap="onCopyLine" data-value="{{block.text}}" selectable user-select>{{block.text}}</text>
        <view wx:elif="{{block.type==='heading'}}" class="block-heading">{{block.text}}</view>
        <view wx:elif="{{block.type==='image' && block.src}}" class="figure"><image class="article-image" src="{{block.src}}" mode="widthFix" binderror="onMediaError" lazy-load bindtap="onPreviewImage" data-src="{{block.src}}" show-menu-by-longpress /></view>
        <scroll-view wx:elif="{{block.type==='table'}}" scroll-x class="table-scroll"><view class="wiki-table"><view class="table-row table-head"><text wx:for="{{block.headers}}" wx:for-item="cell" wx:key="index" class="table-cell">{{cell}}</text></view><view wx:for="{{block.rows}}" wx:for-item="row" wx:key="index" class="table-row"><text wx:for="{{row}}" wx:for-item="cell" wx:key="index" class="table-cell" bindtap="onCopyLine" data-value="{{cell}}">{{cell}}</text></view></view></scroll-view>
        <view wx:if="{{block.links && block.links.length}}" class="inline-links"><text wx:for="{{block.links}}" wx:for-item="link" wx:key="category" bindtap="onBlockCategory" data-category="{{link.category}}">{{link.label}} ›</text></view>
      </view></block>
      <block wx:else><text wx:for="{{article.displayLines}}" wx:key="*this" class="paragraph" bindtap="onCopyLine" data-value="{{item}}" selectable user-select>{{item}}</text></block>
    </view>
    <view wx:if="{{images.length && !article.blocks}}" id="article-images" class="article-section"><view class="section-title">参考图片</view><text class="caption">点击放大查看，长按可使用微信图片菜单。</text><view wx:for="{{images}}" wx:key="*this" class="figure"><image src="{{item}}" mode="widthFix" binderror="onMediaError" lazy-load class="article-image" bindtap="onPreviewImage" data-src="{{item}}" show-menu-by-longpress /><text class="caption">图 {{index+1}} · {{article.title}}</text></view></view>
    <view wx:if="{{article.document}}" id="article-document" class="article-section"><view class="section-title">查看原文件</view><button class="resource-button" bindtap="onOpenDocument" loading="{{documentLoading}}" disabled="{{documentLoading}}">打开 {{article.document.name}}</button></view>
    <view wx:if="{{article.resource}}" id="article-resource" class="article-section"><view class="section-title">配置文件</view><text class="paragraph">{{article.resource.name}}</text><button class="resource-button" bindtap="onShareResource" loading="{{resourceLoading}}" disabled="{{resourceLoading}}">{{resourcePath?'分享 RC 配置文件':'下载 RC 配置文件'}}</button></view>
    <view wx:if="{{related.length}}" id="article-related" class="article-section"><view class="section-title">{{model==='elantra'?'关联词条':'同分类词条'}}</view><view wx:for="{{related}}" wx:key="id" class="related-entry" data-id="{{item.id}}" bindtap="onRelated"><text>{{item.title}}</text><text>›</text></view></view>
    <view id="article-source" class="article-section"><view class="section-title">来源与说明</view><text class="source-note" selectable>{{sourceNote}}</text><text class="back-top" bindtap="onAnchor" data-target="article-top">返回顶部 ↑</text></view>
  </block>
  <view wx:else class="not-found"><view class="article-title">词条未找到</view><text>该链接可能已失效，请回到目录查找资料。</text><button bindtap="onWikiHome">返回知识库目录</button></view>
</view></scroll-view>
