page{height:100vh;display:flex;flex-direction:column;background:var(--bg-page);color:var(--text-primary)}.article-scroll{flex:1;height:0;min-height:0}.article-body{padding:28rpx 34rpx 80rpx}.home-link{padding:16rpx;color:var(--text-secondary);font-size:25rpx}.breadcrumb{font-size:23rpx;color:var(--text-secondary);line-height:1.8;padding:10rpx 0 24rpx}.separator{color:var(--text-primary);opacity:.4}.article-title{font-size:45rpx;font-weight:800;line-height:1.4;padding-bottom:18rpx;border-bottom:2rpx solid var(--border-item);overflow-wrap:anywhere}.article-category{display:block;font-size:22rpx;line-height:1.7;color:var(--text-primary);opacity:.55;margin-top:18rpx}.article-tools{display:flex;gap:28rpx;color:var(--text-secondary);font-size:23rpx;padding:24rpx 0}.contents{padding:24rpx;border:1rpx solid var(--border-item);border-radius:8rpx;background:var(--bg-card);margin:12rpx 0 40rpx}.contents text{display:block;color:var(--text-secondary);font-size:24rpx;padding:10rpx 0}.contents .contents-title{font-size:26rpx;font-weight:700;color:var(--text-primary);padding-bottom:14rpx}.article-section{padding:14rpx 0 34rpx;scroll-margin-top:24rpx}.section-title{font-size:31rpx;font-weight:700;border-bottom:1rpx solid var(--border-item);padding:0 0 16rpx;margin-bottom:16rpx}.paragraph{display:block;font-size:28rpx;line-height:1.95;padding:12rpx 0;color:var(--text-primary);white-space:pre-wrap;overflow-wrap:anywhere}.paragraph+.paragraph{border-top:1rpx solid var(--border-item)}.figure{margin-top:24rpx}.article-image{display:block;width:100%;border:1rpx solid var(--border-item);border-radius:6rpx;background:var(--bg-card)}.caption{display:block;font-size:22rpx;color:var(--text-primary);opacity:.55;line-height:1.8;margin:12rpx 0}.related-entry{display:flex;justify-content:space-between;gap:20rpx;color:var(--text-secondary);font-size:27rpx;line-height:1.7;padding:23rpx 0;border-bottom:1rpx solid var(--border-item)}.source-note{display:block;font-size:24rpx;line-height:1.85;color:var(--text-primary);opacity:.65}.back-top{display:block;margin-top:30rpx;font-size:24rpx;color:var(--text-secondary)}.resource-button,.not-found button{background:var(--bg-card);color:var(--text-secondary);font-size:25rpx;margin:18rpx 0;border:1rpx solid var(--border-item)}.not-found>text{display:block;font-size:27rpx;line-height:1.8;margin:24rpx 0}

.parts-list{margin:20rpx 0}.part-row{padding:24rpx 0;border-bottom:1rpx solid var(--border-item)}.part-heading{display:flex;gap:18rpx;align-items:baseline;flex-wrap:wrap;margin-bottom:14rpx}.part-name{font-size:30rpx;font-weight:700;color:var(--text-primary)}.part-brand{font-size:23rpx;color:var(--text-primary);opacity:.62}.part-codes{display:flex;flex-wrap:wrap;gap:12rpx}.part-code{display:flex;align-items:center;gap:24rpx;margin:0;padding:16rpx 20rpx;line-height:1.4;font-size:28rpx;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--text-secondary);background:var(--bg-card);border:1rpx solid var(--border-item);border-radius:8rpx;word-break:break-all}.part-code::after{border:0}.copy-label{font-family:system-ui;font-size:21rpx;opacity:.65;flex:none}.source-indent-1{padding-left:20rpx}.source-indent-2{padding-left:40rpx}.source-indent-3{padding-left:60rpx}.block-heading{font-size:29rpx;font-weight:700;margin:30rpx 0 16rpx}.source-block .paragraph{border-top:0}.table-scroll{margin:20rpx 0}.wiki-table{display:table;min-width:100%;border-left:1rpx solid var(--border-item);border-top:1rpx solid var(--border-item)}.table-row{display:table-row}.table-cell{display:table-cell;white-space:nowrap;padding:16rpx;font-size:24rpx;line-height:1.7;border-right:1rpx solid var(--border-item);border-bottom:1rpx solid var(--border-item)}.table-head{font-weight:700;background:var(--bg-card)}.inline-links{display:flex;flex-wrap:wrap;gap:18rpx;color:var(--text-secondary);font-size:25rpx;margin:10rpx 0 20rpx}

.part-codes{justify-content:flex-start}.part-codes .part-code{margin:0;width:auto;max-width:100%;display:inline-flex;box-sizing:border-box}
