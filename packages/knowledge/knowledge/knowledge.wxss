page{height:100vh;display:flex;flex-direction:column;background:var(--bg-page);color:var(--text-primary)}.knowledge-scroll{flex:1;height:0;min-height:0}.model-tabs{display:flex;flex:none;padding:0 30rpx;background:var(--bg-card);border-bottom:1rpx solid var(--border-item)}.model-tab{flex:1;padding:23rpx 10rpx;text-align:center;font-size:27rpx;border-bottom:4rpx solid transparent}.model-tab-active{font-weight:700;border-bottom-color:var(--text-secondary);color:var(--text-secondary)}.wiki-body{padding:38rpx 30rpx 72rpx}.wiki-hero{padding:14rpx 0 30rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:var(--text-secondary)}.wiki-title{font-size:44rpx;font-weight:800;line-height:1.35;margin:18rpx 0}.wiki-title text{display:block;font-size:30rpx;font-weight:400;margin-top:8rpx}.description{display:block;font-size:25rpx;line-height:1.7;color:var(--text-primary);opacity:.78}.stats{display:block;margin-top:18rpx;color:var(--text-secondary);font-size:22rpx}.search-row{display:flex;align-items:center;gap:20rpx;border:1rpx solid var(--border-item);border-radius:10rpx;background:var(--bg-card);padding:0 20rpx}.search{height:84rpx;min-width:0;flex:1;font-size:25rpx;color:var(--text-primary)}.search-placeholder{color:var(--text-primary);opacity:.45}.clear-search,.wiki-link{color:var(--text-secondary);font-size:24rpx}.breadcrumb{font-size:23rpx;line-height:1.7;padding:24rpx 0;color:var(--text-primary);opacity:.85}.heading-row{display:flex;justify-content:space-between;gap:20rpx;align-items:center;margin:16rpx 0 22rpx}.heading{font-size:31rpx;font-weight:700}.subtle{font-size:22rpx;color:var(--text-primary);opacity:.56}.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1rpx solid var(--border-item);border-left:1rpx solid var(--border-item);border-radius:10rpx;overflow:hidden}.category-entry{padding:24rpx 20rpx;border-right:1rpx solid var(--border-item);border-bottom:1rpx solid var(--border-item);background:var(--bg-card)}.category-name{display:block;font-size:26rpx;font-weight:600;line-height:1.4}.category-count{display:block;font-size:21rpx;color:var(--text-secondary);margin-top:8rpx}.entries-heading{margin-top:40rpx;padding-bottom:16rpx;border-bottom:2rpx solid var(--border-item)}.category-nav{padding:0 0 18rpx}.section-heading{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:700;margin-top:30rpx;padding:12rpx 0}.entry{padding:25rpx 0;border-bottom:1rpx solid var(--border-item)}.entry-title{display:flex;align-items:baseline;justify-content:space-between;gap:18rpx;font-size:29rpx;line-height:1.5;font-weight:600;color:var(--text-secondary)}.entry-arrow{flex:none;font-weight:400}.entry-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:24rpx;line-height:1.7;margin-top:8rpx;color:var(--text-primary);opacity:.76}.entry-tags{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:12rpx;font-size:20rpx;color:var(--text-primary);opacity:.5}.contacts{margin-top:46rpx;padding-top:26rpx;border-top:1rpx solid var(--border-item)}.contact-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid var(--border-item)}.contact-name{display:block;font-size:26rpx;margin-bottom:7rpx}.source-note{display:block;font-size:22rpx;line-height:1.8;color:var(--text-primary);opacity:.52;padding-top:34rpx}.empty-result{padding:32rpx 0;font-size:27rpx;line-height:1.8}.empty-result text{display:block;font-size:24rpx;margin-top:12rpx}

.index-code{display:flex;align-items:center;gap:14rpx;margin-top:12rpx;flex-wrap:wrap}.code-label,.copy-label{font-size:20rpx;opacity:.6}.code-value{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:26rpx;color:var(--text-secondary);background:var(--bg-card);padding:8rpx 12rpx;border:1rpx solid var(--border-item);border-radius:6rpx}.index-code .copy-label{color:var(--text-secondary)}

.description{white-space:pre-line}.source-link{margin-top:16rpx;min-height:72rpx;padding:8rpx 0;font-size:24rpx;line-height:1.7;color:var(--text-secondary)}.source-link-label{display:block}.source-link-url{font-weight:700;word-break:break-all;overflow-wrap:anywhere}.source-link-hint{display:block;font-size:21rpx;margin-top:4rpx}

.supplemental-section{margin-top:32rpx}.supplemental-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx 20rpx;border:1rpx solid var(--border-item);border-radius:10rpx;background:var(--bg-card);color:var(--text-secondary)}

/* 5N keeps its original hierarchy; index rows are titles, not truncated prose. */
.wiki-5n .wiki-section{border:1rpx solid var(--border-item);border-radius:10rpx;overflow:hidden;margin:0 0 28rpx;background:var(--bg-card)}.wiki-5n .section-heading{margin:0;padding:22rpx;border-bottom:1rpx solid var(--border-item);border-left:6rpx solid var(--text-secondary);gap:20rpx;line-height:1.6}.wiki-5n .section-heading .subtle{flex:none}.wiki-5n .entry{margin:0 22rpx;padding:24rpx 0}.wiki-5n .entry:last-child{border-bottom:0}.wiki-5n .entry-title{font-size:28rpx;line-height:1.6;color:var(--text-primary)}.wiki-5n .entry-arrow{color:var(--text-secondary)}

.category-entry-wide{grid-column:1 / -1}

.external-document{padding:24rpx;border:1rpx solid var(--border-item);border-radius:10rpx;background:var(--bg-card);margin-bottom:24rpx}.external-document .source-link-url{display:block;font-size:22rpx;line-height:1.6;color:var(--text-secondary);margin:20rpx 0}.external-document button{color:var(--text-primary);background:var(--bg-page);margin:0}

.external-document button+button{margin-left:16rpx}
