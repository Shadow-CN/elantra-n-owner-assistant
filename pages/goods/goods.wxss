page { display:flex; flex-direction:column; height:100vh; background:var(--bg-page); }
.goods-scroll { flex:1; height:0; min-height:0; }
.goods-body { padding:24rpx 32rpx 64rpx; }
.goods-copy-hint { display:block; margin-bottom:20rpx; color:var(--goods-note, #667085); font-size:24rpx; line-height:1.6; }
.goods-item { padding:28rpx 0; border-bottom:1rpx solid var(--border-item); }
.goods-category { color:var(--text-primary); font-size:30rpx; font-weight:600; line-height:1.5; word-break:break-all; }
.goods-contact { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:14rpx; }
.goods-name { flex:1; min-width:0; color:var(--text-primary); font-size:28rpx; line-height:1.6; word-break:break-all; }
.goods-wechat { display:flex; align-items:center; gap:16rpx; max-width:65%; min-width:0; padding:12rpx 0 12rpx 12rpx; color:var(--text-tag); font-size:26rpx; line-height:1.6; }
.goods-wechat text { min-width:0; word-break:break-all; }
.goods-wechat-active { opacity:.65; }
.goods-copy-icon { position:relative; flex-shrink:0; width:20rpx; height:24rpx; border:2rpx solid currentColor; margin:6rpx 4rpx 0 0; }
.goods-copy-icon::before { content:''; position:absolute; width:16rpx; height:20rpx; left:-8rpx; top:-8rpx; border-left:2rpx solid currentColor; border-top:2rpx solid currentColor; }
.goods-note { display:block; margin-top:14rpx; color:var(--goods-note, #667085); font-size:24rpx; line-height:1.7; word-break:break-all; }
