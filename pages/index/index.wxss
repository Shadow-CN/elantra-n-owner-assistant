page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

.home-scroll {
  flex: 1;
}

.home-body {
  padding: 48rpx 32rpx 64rpx;
}

.home-hero {
  padding: 28rpx 0 56rpx;
}

.home-kicker {
  display: block;
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.home-title {
  margin-top: 14rpx;
  color: var(--text-primary);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-intro {
  display: block;
  margin-top: 16rpx;
  color: var(--text-hint);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  margin-bottom: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.section-heading-more {
  margin-top: 48rpx;
}

.tool-card,
.coming-card {
  border: 1rpx solid var(--border-default);
  border-radius: 20rpx;
  background: var(--bg-card);
}

.tool-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  gap: 20rpx;
}

.tool-card-spaced {
  margin-top: 16rpx;
}

.tool-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--bg-accent);
  color: var(--text-accent);
  font-size: 22rpx;
  font-weight: 700;
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tool-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.tool-status {
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: var(--bg-chip-active);
  color: var(--text-chip-act);
  font-size: 20rpx;
}

.tool-desc,
.coming-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.tool-arrow {
  color: var(--text-tag);
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.coming-card {
  padding: 28rpx;
}

.coming-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.credits {
  margin-top: 36rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-item);
}

.credits .section-heading {
  font-size: 22rpx;
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.credits-intro {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-hint);
  font-size: 20rpx;
  line-height: 1.6;
}

.credits-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0;
  font-size: 22rpx;
  line-height: 1.6;
}

.credits-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  word-break: break-all;
}

.credits-role {
  flex-shrink: 0;
  color: var(--text-secondary);
  text-align: right;
}
