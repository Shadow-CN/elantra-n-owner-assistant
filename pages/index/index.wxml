<page-meta page-style="{{pageStyle}}" />
<navigation-bar title="现代N车主助手" back="{{false}}" color="{{navColor}}" background="{{navBg}}">
	<view slot="right" class="theme-toggle" bindtap="onThemeToggle" aria-role="button" aria-label="切换主题">
		<view class="theme-icon theme-icon-{{themeMode}}"></view>
	</view>
</navigation-bar>

<scroll-view class="home-scroll" scroll-y>
	<view class="home-body">
		<view class="home-hero">
			<text class="home-kicker">ELANTRA N / IONIQ 5N</text>
			<view class="home-title">现代N车主助手</view>
			<text class="home-intro">车主实用工具与赛道成绩，按需要选择使用。</text>
		</view>

		<view class="section-heading">可用工具</view>
		<view class="tool-card" bindtap="onOpenKnowledge" aria-role="button" aria-label="打开车主 Wiki">
			<view class="tool-icon">Wiki</view>
			<view class="tool-info">
				<view class="tool-title-row">
					<text class="tool-title">车主知识库</text>
					<!-- <text class="tool-status">Wiki</text> -->
				</view>
				<text class="tool-desc">按车型与分类查阅配件、保养规格和使用资料。</text>
			</view>
			<text class="tool-arrow">›</text>
		</view>

		<view class="tool-card tool-card-spaced" bindtap="onOpenObdTool" aria-role="button" aria-label="打开 OBD 参数配置">
			<view class="tool-icon">OBD</view>
			<view class="tool-info">
				<view class="tool-title-row">
					<text class="tool-title">OBD参数配置</text>
					<!-- <text class="tool-status">监控</text> -->
				</view>
				<text class="tool-desc">筛选原厂 PID，选择参数并导出 Car Scanner 或 RaceChrono 配置。</text>
			</view>
			<text class="tool-arrow">›</text>
		</view>

		<view class="tool-card tool-card-spaced" bindtap="onOpenLaps" aria-role="button" aria-label="打开赛道圈速榜">
			<view class="tool-icon">LAP</view>
			<view class="tool-info">
				<view class="tool-title-row"><text class="tool-title">赛道圈速榜</text>
				<!-- <text class="tool-status">圈速</text> -->
				</view>
				<text class="tool-desc">上传圈速视频，记录车辆配置，与车友分享赛道成绩。</text>
			</view><text class="tool-arrow">›</text>
		</view>

		<view class="tool-card tool-card-spaced" bindtap="onOpenGoods" aria-role="button" aria-label="打开车友好物">
			<view class="tool-icon">Goods</view>
			<view class="tool-info">
				<view class="tool-title-row">
					<text class="tool-title">车友好物</text>
					<!-- <text class="tool-status">车友</text> -->
				</view>
				<text class="tool-desc">车机、设计、配件与改装联系信息。</text>
			</view>
			<text class="tool-arrow">›</text>
		</view>

		<view class="tool-card tool-card-spaced" bindtap="onOpenTools" aria-role="button" aria-label="打开实用工具">
			<view class="tool-icon">Tools</view>
			<view class="tool-info">
				<view class="tool-title-row">
					<text class="tool-title">实用工具</text>
					<!-- <text class="tool-status">工具</text> -->
				</view>
				<text class="tool-desc">压力换算、轮毂模拟器等日常小工具，集中在这里。</text>
			</view>
			<text class="tool-arrow">›</text>
		</view>

		<view class="section-heading section-heading-more">更多工具</view>
		<view class="coming-card">
			<text class="coming-title">持续扩展中</text>
			<text class="coming-desc">新的车主工具会在这里提供入口。</text>
		</view>

		<view class="credits">
			<view class="section-heading">鸣谢</view>
			<text class="credits-intro">感谢以下车友提供数据源、知识资料、技术支持与美术素材，排名不分先后</text>
			<view class="credits-row">
				<text class="credits-name">南鸵鸟</text>
				<text class="credits-role">OBD 数据</text>
			</view>
			<view class="credits-row">
				<text class="credits-name">羊驼 / 红脸 / 一吨98获奖者</text>
				<text class="credits-role">EN 知识库</text>
			</view>
			<view class="credits-row">
				<text class="credits-name">德国鸡腿堡</text>
				<text class="credits-role">5N 知识库</text>
			</view>
			<view class="credits-row">
				<text class="credits-name">薯条</text>
				<text class="credits-role">美术素材</text>
			</view>
		</view>
	</view>
</scroll-view>