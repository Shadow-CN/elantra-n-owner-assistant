page{height:100vh;display:flex;flex-direction:column;background:var(--bg-page);color:var(--text-primary)}.scroll{flex:1;min-height:0}.body{padding:32rpx 28rpx 80rpx}.hero{padding:24rpx 0 34rpx}.kicker{font-size:22rpx;letter-spacing:4rpx;color:var(--text-secondary)}.title{font-size:46rpx;font-weight:900;margin:20rpx 0}.hint{display:block;font-size:24rpx;line-height:1.7;color:var(--text-secondary);margin:14rpx 0}.tabs{display:flex;gap:12rpx;margin-bottom:24rpx}.tabs button{flex:1;margin:0}.active,.primary{background:var(--bg-accent)!important;color:var(--text-accent)!important}.card{padding:28rpx;margin:20rpx 0;border:1rpx solid var(--border-default);border-radius:20rpx;background:var(--bg-card)}.label{display:block;font-size:24rpx;color:var(--text-secondary);margin:22rpx 0 10rpx}.picker,input,textarea{box-sizing:border-box;width:100%;padding:20rpx 16rpx;background:var(--bg-page);border-radius:10rpx;font-size:28rpx;min-height:80rpx;color:var(--text-primary)}input{height:88rpx}textarea{min-height:160rpx}.row{display:flex;align-items:center;gap:24rpx}.row-main{flex:1;min-width:0;overflow-wrap:break-word}.rank{font-weight:900;color:var(--text-secondary);font-size:38rpx}.time{font-size:46rpx;font-weight:900;font-variant-numeric:tabular-nums;margin:12rpx 0}.empty{padding:48rpx 16rpx;text-align:center;color:var(--text-secondary)}button{margin-top:18rpx;background:var(--bg-btn-sec);color:var(--text-btn-sec);font-size:28rpx}.tabs button{margin-top:0}.mods{white-space:pre-wrap;overflow-wrap:break-word}video{width:100%;height:400rpx;margin-top:24rpx}.error{line-height:1.8}.detail{border-width:3rpx}

.row{flex-wrap:wrap}.row-actions{width:100%;display:flex;gap:16rpx;justify-content:flex-end}.row-actions button{margin:0}

.mod-badge,.stock-badge{display:block;margin-top:12rpx;font-size:23rpx;color:var(--text-secondary)}.mod-badge{font-weight:700}.mod-form{padding:8rpx 16rpx 22rpx;margin-top:20rpx;border-left:3rpx solid var(--border-default)}

.privacy-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}.privacy-card{width:100%;max-width:640rpx;padding:36rpx;box-sizing:border-box;border-radius:24rpx;background:var(--bg-card);color:var(--text-primary);border:1rpx solid var(--border-default)}.privacy-title{font-size:32rpx;font-weight:700}.privacy-copy{font-size:26rpx;line-height:1.8;margin:24rpx 0}.privacy-link{font-size:24rpx;color:var(--text-secondary)}

.lap-inputs{display:flex;align-items:flex-start;width:100%;max-width:560rpx;box-sizing:border-box}.lap-part{flex:1 1 0%;width:0;min-width:0;text-align:center}.lap-milliseconds{flex:1.3 1 0%}.lap-input-frame{box-sizing:border-box;width:100%;height:88rpx;border:1rpx solid var(--border-default);border-radius:10rpx;overflow:hidden;background:var(--bg-page)}.lap-inputs input{display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0;height:86rpx;min-height:0;padding:0;border:0;border-radius:0;background:transparent;text-align:center;font-size:36rpx;font-weight:600;font-variant-numeric:tabular-nums}.lap-unit{display:block;margin-top:10rpx;font-size:24rpx;color:var(--text-secondary);white-space:nowrap}.lap-separator{flex:0 0 28rpx;width:28rpx;text-align:center;font-size:36rpx;line-height:88rpx;color:var(--text-secondary)}.lap-input-error{display:block;font-size:24rpx;color:var(--text-error);margin:10rpx 0}

.video-link-input{min-height:150rpx}.external-video{margin-top:24rpx;padding-top:10rpx;border-top:1rpx solid var(--border-default)}.video-link-text{display:block;overflow-wrap:anywhere;word-break:break-all;font-size:26rpx;line-height:1.6;color:var(--text-secondary)}

.progress-title{font-size:32rpx;font-weight:700;margin-top:28rpx}.progress-track{font-size:28rpx;font-weight:700}.progress-best{padding:14rpx 0 20rpx;border-bottom:1rpx solid var(--border-item)}.progress-best-label{font-size:23rpx;color:var(--text-secondary)}.progress-gain{font-size:26rpx;font-weight:600;color:var(--text-secondary)}.progress-timeline{margin-top:22rpx}.progress-step{display:flex;align-items:flex-start;gap:20rpx;padding:14rpx 0}.progress-date{flex-shrink:0;font-size:22rpx;line-height:1.8;color:var(--text-secondary)}.progress-step-main{min-width:0;flex:1}.progress-lap{font-size:26rpx;font-weight:600;font-variant-numeric:tabular-nums}.progress-delta{display:inline-block;margin-left:12rpx;font-size:22rpx;font-weight:400;color:var(--text-secondary)}.progress-config{display:block;font-size:22rpx;line-height:1.7;overflow-wrap:anywhere;color:var(--text-primary);opacity:.7}
