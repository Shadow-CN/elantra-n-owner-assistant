/* pages/params/params.wxss */

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

/* Filter bar */
.filter-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 32rpx;
  background: var(--bg-tag);
  flex-shrink: 0;
}

.filter-tag {
  font-size: 24rpx;
  color: var(--text-tag);
  font-weight: 500;
}

.filter-sep {
  margin: 0 8rpx;
  color: var(--text-hint);
  font-size: 22rpx;
}

.filter-total {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* Toolbar */
.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--bg-toolbar);
  border-bottom: 1rpx solid var(--border-default);
  flex-shrink: 0;
}

.toolbar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.checkbox-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border-check);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-checked {
  background: var(--bg-item-sel);
  border-color: var(--bg-item-sel);
}

.checkbox-tick {
  font-size: 22rpx;
  color: var(--text-accent);
  font-weight: 700;
}

.toolbar-text {
  font-size: 28rpx;
  color: var(--text-toolbar);
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-tag);
}

/* Param list */
.list-scroll {
  flex: 1;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.param-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-item);
  gap: 20rpx;
}

.param-item-checked {
  background: var(--bg-item-sel);
}

.param-item-checked .param-name-cn,
.param-item-checked .param-name-en,
.param-item-checked .param-unit {
  color: var(--text-selection);
}

.param-info {
  flex: 1;
  min-width: 0;
}

.param-name-cn {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}

.param-name-en {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.4;
  word-break: break-all;
}

.param-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.param-ecu {
  font-size: 22rpx;
  color: var(--text-tag);
  background: var(--bg-tag);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.param-unit {
  margin-left: 7rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* Empty state */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
  gap: 12rpx;
}

.empty-sub {
  font-size: 22rpx;
}

/* Cart sheet above bottom bar */
.cart-sheet {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 120rpx;
  left: 0;
  height: 720rpx;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-default);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.cart-sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
}

.cart-sheet-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-sheet-clear {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-tag);
}

.cart-sheet-list {
  flex: 1;
  min-height: 0;
}

.is-hidden {
  display: none;
}

.cart-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
  gap: 16rpx;
}

.cart-item-info {
  flex: 1;
  min-width: 0;
}

.cart-item-remove {
  font-size: 24rpx;
  color: var(--text-error);
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 16rpx;
}

.cart-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* Bottom bar */
.bottom-bar {
  position: fixed;
  z-index: 11;
  right: 0;
  bottom: 0;
  left: 0;
  height: 120rpx;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  background: var(--bg-bar);
  border-top: 1rpx solid var(--border-bottom-bar);
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.cart-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
  flex-shrink: 0;
}

.cart-entry-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-entry-arrow {
  font-size: 20rpx;
  color: var(--text-tag);
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: var(--bg-accent);
  color: var(--text-accent);
}

.btn-disabled {
  background: var(--border-check);
  color: var(--text-accent);
}
