<!-- pages/params/params.wxml -->
<page-meta page-style="{{pageStyle}}" />
<navigation-bar title="选择参数" back="{{true}}" color="{{navColor}}" background="{{navBg}}">
  <view slot="right" class="theme-toggle" bindtap="onThemeToggle" aria-role="button" aria-label="切换主题">
    <view class="theme-icon theme-icon-{{themeMode}}"></view>
  </view>
</navigation-bar>

<!-- 筛选状态栏 -->
<view class="filter-bar">
  <text class="filter-tag">{{filterEcuLabel}}</text>
  <text class="filter-sep">·</text>
  <text class="filter-tag">{{filterTypeLabel}}</text>
  <text class="filter-total">共 {{totalCount}} 个</text>
</view>

<!-- 工具栏：全选 / 取消全选 -->
<view class="toolbar">
  <view class="toolbar-left">
    <view class="checkbox-wrap" bindtap="onSelectAll">
      <view class="checkbox {{allChecked ? 'checkbox-checked' : ''}}">
        <text wx:if="{{allChecked}}" class="checkbox-tick">✓</text>
      </view>
      <text class="toolbar-text">全选</text>
    </view>
    <text
      wx:if="{{selectedCount > 0}}"
      class="clear-btn"
      bindtap="onClearAll"
    >取消全选</text>
  </view>
</view>

<!-- 参数列表 -->
<scroll-view class="list-scroll" scroll-y>
  <view
    wx:for="{{pids}}"
    wx:key="id"
    class="param-item {{item.checked ? 'param-item-checked' : ''}}"
    bindtap="onItemTap"
    data-index="{{index}}"
  >
    <!-- 左侧 checkbox -->
    <view class="checkbox {{item.checked ? 'checkbox-checked' : ''}}">
      <text wx:if="{{item.checked}}" class="checkbox-tick">✓</text>
    </view>

    <!-- 参数信息 -->
    <view class="param-info">
      <view class="param-name-cn">{{item.name_cn}}</view>
      <view class="param-name-en">{{item.name_en}}</view>
      <view class="param-meta">
        <text class="param-ecu">{{item.ecu_label}}</text>
        <text wx:if="{{item.unit}}" class="param-unit"> · {{item.unit}}</text>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:if="{{totalCount === 0}}" class="empty-tip">
    <text>该筛选条件下没有参数</text>
    <text class="empty-sub">请返回调整筛选条件</text>
  </view>
</scroll-view>

<!-- 底部：已选购物车 + 导出 -->
<view class="cart-sheet {{cartOpen ? '' : 'is-hidden'}}">
  <view class="cart-sheet-head">
    <text class="cart-sheet-title">已选参数</text>
    <text class="cart-sheet-clear" bindtap="onClearCart">清空</text>
  </view>
  <view wx:if="{{cartCount === 0}}" class="cart-empty">还没有选择参数</view>
  <scroll-view class="cart-sheet-list {{cartCount === 0 ? 'is-hidden' : ''}}" scroll-y>
    <view>
      <view
        wx:for="{{cartPids}}"
        wx:key="id"
        class="cart-item"
      >
        <view class="cart-item-info">
          <view class="param-name-cn">{{item.name_cn}}</view>
          <view class="param-name-en">{{item.name_en}}</view>
          <view class="param-meta">
            <text class="param-ecu">{{item.ecu_label}}</text>
            <text wx:if="{{item.unit}}" class="param-unit"> · {{item.unit}}</text>
          </view>
        </view>
        <text class="cart-item-remove" catchtap="onRemoveCartItem" data-id="{{item.id}}">移除</text>
      </view>
    </view>
  </scroll-view>
</view>

<view class="bottom-bar">
  <view class="cart-entry" bindtap="onToggleCart">
    <text class="cart-entry-label">已选 {{cartCount}} 个</text>
    <text class="cart-entry-arrow">{{cartOpen ? '▼' : '▲'}}</text>
  </view>
  <view
    class="btn btn-primary {{cartCount === 0 ? 'btn-disabled' : ''}}"
    bindtap="onGoExport"
  >导出</view>
</view>
