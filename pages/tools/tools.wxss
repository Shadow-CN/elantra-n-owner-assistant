page { display:flex; flex-direction:column; height:100vh; background:var(--bg-page); }

.tools-scroll { flex:1; height:0; min-height:0; }

.tools-body {
  padding: 42rpx 32rpx 72rpx;
}

.tools-hero { padding: 28rpx 0 48rpx; }

.tools-kicker {
  display: block;
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.tools-title {
  margin-top: 16rpx;
  color: var(--text-primary);
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.1;
}

.tools-desc {
  display: block;
  margin-top: 18rpx;
  color: var(--text-hint);
  font-size: 25rpx;
  line-height: 1.7;
}

.tools-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-default);
  border-radius: 20rpx;
  background: var(--bg-card);
}

.tools-card-spaced { margin-top: 16rpx; }

.tools-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--bg-accent);
  color: var(--text-accent);
  font-size: 22rpx;
  font-weight: 700;
}

.tools-icon-soon {
  border: 1rpx solid var(--border-default);
  background: var(--bg-page);
  color: var(--text-secondary);
}

.tools-info { flex: 1; min-width: 0; }

.tools-title-row { display: flex; align-items: center; gap: 12rpx; }

.tools-name {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.tools-status {
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: var(--bg-chip-active);
  color: var(--text-chip-act);
  font-size: 20rpx;
}

.tools-status-soon {
  border: 1rpx solid var(--text-badge);
  background: var(--bg-card);
  color: var(--text-badge);
}

.tools-card-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.tools-arrow {
  color: var(--text-tag);
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.tools-arrow-soon { color: var(--text-badge); }

.tools-note {
  margin-top: 32rpx;
  color: var(--text-hint);
  font-size: 22rpx;
  line-height: 1.6;
}
