page{height:100vh;display:flex;flex-direction:column;background:var(--bg-page);color:var(--text-primary)}.scroll{flex:1;min-height:0}.body{padding:12rpx 28rpx 80rpx}.card{box-sizing:border-box;padding:28rpx;margin:20rpx 0;border:1rpx solid var(--border-default);border-radius:20rpx;background:var(--bg-card)}.section-title{font-size:30rpx;font-weight:700;margin-bottom:20rpx}.hint{display:block;font-size:24rpx;line-height:1.7;color:var(--text-secondary);margin:14rpx 0}.label{font-size:24rpx;color:var(--text-secondary)}.lap-time{font-size:54rpx;font-weight:800;font-variant-numeric:tabular-nums}.info-row{display:flex;align-items:flex-start;gap:24rpx;padding:20rpx 0;border-top:1rpx solid var(--border-default)}.info-row .label{flex:0 0 144rpx;line-height:1.6}.value{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;font-size:28rpx;line-height:1.6}.video-link-text{display:block;word-break:break-all;font-size:26rpx;line-height:1.7;margin-top:12rpx}.link-actions{display:flex;gap:16rpx;flex-wrap:wrap}.link-actions button{margin-left:0;margin-right:0}button{background:var(--bg-btn-sec);color:var(--text-btn-sec);font-size:26rpx;margin-top:20rpx}video{display:block;width:100%;height:370rpx;border-radius:12rpx}.external-video{margin-top:20rpx}.empty{padding:60rpx 20rpx;text-align:center;color:var(--text-secondary)}
