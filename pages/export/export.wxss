/* pages/export/export.wxss */

.page-scroll {
  height: 100vh;
  background: #F6F7F8;
}

.page-body {
  padding: 0 0 48rpx 0;
}

/* Summary card */
.summary-card {
  background: #1A73E8;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
}

.summary-count {
  font-size: 80rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}

.summary-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

.summary-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  margin-top: 16rpx;
}

/* Section title */
.section-title {
  font-size: 26rpx;
  color: #888;
  padding: 0 32rpx 12rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* App card */
.app-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFFFFF;
  margin: 0 0 2rpx 0;
  padding: 32rpx;
  gap: 16rpx;
}

.app-card:active {
  background: #F0F0F0;
}

.app-card-disabled {
  opacity: 0.45;
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.app-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}

.app-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
}

.arrow {
  font-size: 32rpx;
  color: #1A73E8;
}

.loading-spin {
  font-size: 28rpx;
  color: #888;
}

.badge-soon {
  font-size: 20rpx;
  color: #888;
  background: #F0F0F0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* Result card */
.result-card {
  margin: 24rpx 32rpx 0;
  background: #F0FFF4;
  border: 1rpx solid #B7EBC4;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 24rpx;
  color: #2D7A3A;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

.result-key {
  font-size: 24rpx;
  color: #555;
}

.result-val {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.result-warn {
  color: #D97706;
}

/* Error card */
.error-card {
  margin: 24rpx 32rpx 0;
  background: #FFF5F5;
  border: 1rpx solid #FCA5A5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #B91C1C;
  line-height: 1.6;
}

/* Action row */
.action-row {
  margin: 32rpx 32rpx 0;
  display: flex;
  justify-content: center;
}

.btn {
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.btn-ghost {
  border: 1rpx solid #D0D0D0;
  color: #888;
}
