/* pages/export/export.wxss */

.page-scroll {
  height: 100vh;
  background: var(--bg-page);
}

.page-body {
  padding: 0 0 48rpx 0;
}

/* Summary card */
.summary-card {
  background: var(--bg-accent);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
}

.summary-count {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--text-accent);
  line-height: 1.1;
}

.summary-label {
  font-size: 28rpx;
  color: var(--text-accent);
  margin-top: 8rpx;
}

.summary-hint {
  font-size: 22rpx;
  color: var(--text-accent);
  margin-top: 16rpx;
}

.cart-card {
  background: var(--bg-card);
  margin-bottom: 24rpx;
  border-top: 1rpx solid var(--border-item);
}

.cart-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
}

.cart-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-card-clear {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-tag);
}

.cart-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
  gap: 16rpx;
}

.cart-item-info {
  flex: 1;
  min-width: 0;
}

.cart-name-cn {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}

.cart-name-en {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.4;
  word-break: break-all;
}

.cart-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-tag);
}

.cart-item-remove {
  font-size: 24rpx;
  color: var(--text-error);
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 16rpx;
}

.cart-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* Section title */
.section-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 0 32rpx 12rpx;
  letter-spacing: 1rpx;
}

/* App card */
.app-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--bg-card);
  margin: 0 0 2rpx 0;
  padding: 32rpx;
  gap: 16rpx;
}

.app-card-disabled {
  opacity: 0.45;
}

.app-card-info {
  border-left: 6rpx solid var(--text-tag);
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.app-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.app-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
}

.arrow {
  font-size: 32rpx;
  color: var(--text-tag);
}

.loading-spin {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.badge-soon {
  font-size: 20rpx;
  color: var(--text-badge);
  background: var(--bg-badge);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.badge-info {
  font-size: 20rpx;
  color: var(--text-tag);
  background: var(--bg-tag);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* Result card */
.result-card {
  margin: 24rpx 32rpx 0;
  background: var(--bg-success);
  border: 1rpx solid var(--border-success);
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 24rpx;
  color: var(--text-success);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

.result-key {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-val {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.result-warn {
  color: var(--text-warn);
}

/* Error card */
.error-card {
  margin: 24rpx 32rpx 0;
  background: var(--bg-error);
  border: 1rpx solid var(--border-error);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-error);
  line-height: 1.6;
}

/* Action row */
.action-row {
  margin: 32rpx 32rpx 0;
  display: flex;
  justify-content: center;
}

.btn {
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.btn-ghost {
  border: 1rpx solid var(--border-chip);
  color: var(--text-secondary);
}
