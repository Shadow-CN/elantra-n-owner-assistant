<!-- pages/export/export.wxml -->
<page-meta page-style="{{pageStyle}}" />
<navigation-bar title="导出配置" back="{{true}}" color="{{navColor}}" background="{{navBg}}">
  <view slot="right" class="theme-toggle" bindtap="onThemeToggle" aria-role="button" aria-label="切换主题">
    <view class="theme-icon theme-icon-{{themeMode}}"></view>
  </view>
</navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-body">

    <!-- 已选参数摘要（点击展开购物车） -->
    <view class="summary-card" bindtap="onToggleCart">
      <view class="summary-count">{{selectedCount}}</view>
      <view class="summary-label">个已选参数</view>
      <view class="summary-hint">{{cartOpen ? '点击收起已选列表' : '点击查看已选参数'}}</view>
    </view>

    <view wx:if="{{cartOpen}}" class="cart-card">
      <view class="cart-card-head">
        <text class="cart-card-title">已选列表</text>
        <text class="cart-card-clear" catchtap="onClearCart">清空</text>
      </view>
      <view wx:if="{{selectedCount === 0}}" class="cart-empty">还没有选择参数</view>
      <view
        wx:for="{{selectedPids}}"
        wx:key="id"
        class="cart-item"
      >
        <view class="cart-item-info">
          <view class="cart-name-cn">{{item.name_cn}}</view>
          <view class="cart-name-en">{{item.name_en}}</view>
          <view class="cart-meta">
            <text>{{item.ecu_label}}</text>
            <text wx:if="{{item.unit}}"> · {{item.unit}}</text>
          </view>
        </view>
        <text class="cart-item-remove" catchtap="onRemoveCartItem" data-id="{{item.id}}">移除</text>
      </view>
    </view>

    <!-- 导出目标选择 -->
    <view class="section-title">选择目标 App</view>

    <!-- Car Scanner -->
    <view class="app-card" bindtap="onGenerateCarScanner">
      <view class="app-info">
        <view class="app-name">Car Scanner</view>
        <view class="app-desc">生成 custompids.csp 文件</view>
        <view class="app-desc">支持数值型、位字段（GetBit）</view>
      </view>
      <view class="app-action">
        <view wx:if="{{generating && generatingTarget === 'carScanner'}}" class="loading-spin">…</view>
        <view wx:else class="arrow">→</view>
      </view>
    </view>

    <!-- RaceChrono (未实现) -->
    <view class="app-card app-card-disabled">
      <view class="app-info">
        <view class="app-name">RaceChrono</view>
        <view class="app-desc">即将支持</view>
      </view>
      <view class="app-action">
        <view class="badge-soon">敬请期待</view>
      </view>
    </view>

    <!-- LUFI XF -->
    <view class="app-card" bindtap="onGenerateLufi">
      <view class="app-info">
        <view class="app-name">LUFI XF</view>
        <view class="app-desc">基于官方模板生成二进制 .INI</view>
        <view class="app-desc">打包已选模板为 cn7n_lufi_xf.zip</view>
      </view>
      <view class="app-action">
        <view wx:if="{{generating && generatingTarget === 'lufi'}}" class="loading-spin">…</view>
        <view wx:else class="arrow">→</view>
      </view>
    </view>

    <!-- 上次导出结果 -->
    <view wx:if="{{lastResult}}" class="result-card">
      <view class="result-title">上次导出结果</view>
      <view class="result-row">
        <text class="result-key">成功生成</text>
        <text class="result-val">{{lastResult.total}} 个参数</text>
      </view>
      <view wx:if="{{lastResult.skipped > 0}}" class="result-row">
        <text class="result-key result-warn">跳过</text>
        <text class="result-val result-warn">{{lastResult.skipped}} 个（公式不支持）</text>
      </view>
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{errorMsg}}" class="error-card">
      <text>{{errorMsg}}</text>
    </view>

    <!-- 操作区 -->
    <view class="action-row">
      <view class="btn btn-ghost" bindtap="onClearSelection">清空选择</view>
    </view>

  </view>
</scroll-view>
