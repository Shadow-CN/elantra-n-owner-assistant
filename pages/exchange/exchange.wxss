page{display:flex;flex-direction:column;height:100vh;background:var(--bg-page);color:var(--text-primary)}.exchange-scroll{flex:1;height:0;min-height:0}.exchange-body{padding:44rpx 32rpx 72rpx}.kicker{font-size:20rpx;letter-spacing:3rpx;color:var(--text-secondary)}.title{font-size:52rpx;font-weight:800;margin:20rpx 0}.description,.label{display:block;color:var(--text-secondary);font-size:24rpx;line-height:1.6}.currency-row{display:flex;align-items:center;gap:14rpx;margin:36rpx 0 22rpx}.currency-row picker{flex:1;min-width:0}.currency{padding:22rpx 12rpx;font-size:25rpx;border:1rpx solid var(--border-item);border-radius:10rpx;background:var(--bg-card)}.swap{flex:none;margin:0!important;padding:0 14rpx!important;color:var(--text-primary);background:var(--bg-card)}.field,.result-card{padding:28rpx;border:1rpx solid var(--border-item);border-radius:14rpx;background:var(--bg-card);margin-top:20rpx}.field input{height:88rpx;font-size:42rpx;font-weight:600;color:var(--text-primary);margin-top:12rpx}.placeholder{font-size:30rpx;color:var(--text-secondary);opacity:.55}.result{display:block;font-size:46rpx;font-weight:800;word-break:break-all;line-height:1.5;margin-top:12rpx}.rate{display:block;font-size:24rpx;color:var(--text-secondary);margin-top:14rpx}.rate-info{margin-top:28rpx}.rate-info text{display:block;font-size:23rpx;line-height:1.8;color:var(--text-secondary)}.rate-info button{margin:18rpx 0 0;color:var(--text-primary);background:var(--bg-card)}.error{display:block;margin-top:18rpx;font-size:24rpx;color:var(--text-primary)}.note{display:block;margin-top:30rpx;line-height:1.8;font-size:23rpx;color:var(--text-secondary);opacity:.75}
