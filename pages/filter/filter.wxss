/* pages/filter/filter.wxss */

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.page-body {
  padding: 0 0 24rpx 0;
}

/* Section */
.section {
  padding: 32rpx 32rpx 24rpx;
  background: var(--bg-card);
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

/* Search */
.search-section {
  padding-top: 28rpx;
}

.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-chip);
  border-radius: 16rpx;
  background: var(--bg-page);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: var(--text-primary);
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--text-hint);
}

.search-clear {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 18rpx;
  color: var(--text-tag);
  font-size: 24rpx;
}

.search-empty {
  margin-top: 18rpx;
  color: var(--text-hint);
  font-size: 24rpx;
  text-align: center;
}

.search-results {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-default);
  border-radius: 16rpx;
  background: var(--bg-card);
}

.search-summary {
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid var(--border-item);
  color: var(--text-secondary);
  font-size: 22rpx;
}

.search-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid var(--border-item);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-checked {
  background: rgba(230, 51, 18, 0.08);
}

.search-check {
  width: 42rpx;
  height: 42rpx;
  border: 1rpx solid var(--border-chip);
  border-radius: 50%;
  color: var(--text-tag);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.search-item-checked .search-check {
  border-color: var(--bg-chip-active);
  background: var(--bg-chip-active);
  color: var(--text-chip-act);
}

.search-info {
  flex: 1;
  min-width: 0;
}

/* Chips */
.chip-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid var(--border-chip);
  background: var(--bg-chip);
  font-size: 26rpx;
  color: var(--text-chip);
}

.chip-active {
  background: var(--bg-chip-active);
  border-color: var(--bg-chip-active);
  color: var(--text-chip-act);
}

.chip-count {
  font-size: 22rpx;
  opacity: 0.75;
  margin-left: 4rpx;
}

/* Theme toggle: fixed box so nav title does not shift on mode change */
.theme-toggle {
  width: 44px;
  height: 44px;
  padding: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 22px 22px;
  mask-size: 22px 22px;
}

