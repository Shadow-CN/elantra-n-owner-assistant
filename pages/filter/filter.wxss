  -webkit-mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='4'/%3E%3Cpath d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='4'/%3E%3Cpath d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41'/%3E%3C/svg%3E");
}

.theme-icon-dark {
  -webkit-mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z'/%3E%3C/svg%3E");
}

.theme-icon-auto {
  -webkit-mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Crect x='6' y='2' width='12' height='20' rx='2'/%3E%3Cpath d='M10 18h4'/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Crect x='6' y='2' width='12' height='20' rx='2'/%3E%3Cpath d='M10 18h4'/%3E%3C/svg%3E");
}

/* Cart sheet above bottom bar */
.cart-sheet {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 160rpx;
  left: 0;
  height: 720rpx;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-default);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.cart-sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
  gap: 24rpx;
}

.cart-sheet-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-sheet-clear {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-tag);
}

.cart-sheet-export {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.cart-sheet-list {
  flex: 1;
  min-height: 0;
}

.is-hidden {
  display: none;
}

.cart-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-item);
  gap: 16rpx;
}

.cart-item-info {
  flex: 1;
  min-width: 0;
}

.param-name-cn {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}

.param-name-en {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.4;
  word-break: break-all;
}

.param-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.param-ecu {
  font-size: 22rpx;
  color: var(--text-tag);
  background: var(--bg-tag);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.param-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cart-item-remove {
  font-size: 24rpx;
  color: var(--text-error);
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 16rpx;
}

.cart-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* Bottom bar */
.bottom-bar {
  position: fixed;
  z-index: 11;
  right: 0;
  bottom: 0;
  left: 0;
  height: 160rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: var(--bg-bar);
  border-top: 1rpx solid var(--border-bottom-bar);
  box-shadow: var(--shadow-bar);
}

.result-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.btn-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.cart-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
  flex-shrink: 0;
}

.cart-entry-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cart-entry-arrow {
  font-size: 20rpx;
  color: var(--text-tag);
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary {
  background: var(--bg-accent);
  color: var(--text-accent);
}
